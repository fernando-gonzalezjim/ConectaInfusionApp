{
  "name": "conecta-infusion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @conecta/api\" \"npm run dev -w @conecta/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w @conecta/api",
    "db:migrate": "npm run db:migrate -w @conecta/api",
    "db:up": "docker compose up -d db",
    "test": "npm run test -w @conecta/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
