PORT=3001
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
# Local Docker credentials only. Use your provider's URL for a hosted database.
DATABASE_URL=postgresql://conecta:conecta_local@localhost:5432/conecta

# Identity remains opt-in while implementation is incomplete. See docs/identity-local-email.md.
IDENTITY_ENABLED=false
# Optional absolute private directory; inside this workspace it must be under .local.
# Example on Windows: F:/Code/ConectaInfusionApp/.local/profile-photos
IDENTITY_PHOTO_DIRECTORY=
NODE_ENV=development
IDENTITY_MAIL_TRANSPORT=mailpit
IDENTITY_PUBLIC_ORIGIN=http://localhost:5173
IDENTITY_OUTBOX_ACTIVE_KEY_ID=v1
# Replace privately with {"v1":"<random 32-byte base64 key>"}; no shared development key.
IDENTITY_OUTBOX_KEYS=
# A separate random 32-byte base64 key for abuse counters and recipient hashes.
IDENTITY_THROTTLE_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@conecta.example.test
